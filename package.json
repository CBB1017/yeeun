{
	"name": "yeeun",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=26.13.0 <27"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-server.mjs",
		"build:server": "node scripts/build-server.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && npm run check",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@opentelemetry/api": "1.10.0",
		"cfb": "1.2.2",
		"csv-parse": "7.0.3",
		"drizzle-orm": "0.45.4",
		"exceljs": "4.4.0",
		"fast-xml-parser": "5.11.2",
		"iconv-lite": "0.7.3",
		"jszip": "3.10.2",
		"luxon": "3.7.2",
		"nodemailer": "10.3.1",
		"openid-client": "6.8.8",
		"pdfjs-dist": "6.5.438",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"pptxgenjs": "4.0.1",
		"sharp": "0.35.5",
		"web-push": "3.6.7",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.66.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/luxon": "3.7.6",
		"@types/node": "26.6.6",
		"@types/nodemailer": "8.0.2",
		"@types/pg": "8.23.1",
		"@types/web-push": "3.6.4",
		"bits-ui": "2.20.3",
		"clsx": "2.1.1",
		"drizzle-kit": "0.31.11",
		"esbuild": "0.28.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "4.0.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.18.20": true
	}
}
