# Copy to .env and fill in. Never commit .env. Secrets go in ./.secrets/<name> files
# (created by scripts/init-secrets.sh|.ps1), NOT here.

# --- Public access ---
# Real HTTPS origin users open (e.g. your ngrok stable domain). Google OAuth redirect URIs
# must be <PUBLIC_ORIGIN>/auth/google/callback and <PUBLIC_ORIGIN>/api/drive/callback.
PUBLIC_ORIGIN=http://localhost:3000
WEB_PORT=3000

# --- Identity ---
# Operator's verified Google email; becomes the first administrator on first login.
BOOTSTRAP_ADMIN_EMAIL=

# --- Public policy pages (/privacy, /terms) ---
# Operator name and contact e-mail shown on the privacy policy and terms.
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=

# --- Google OAuth / Picker (operator's Google Cloud project) ---
# Secret parts go to .secrets/google_client_secret and .secrets/google_picker_api_key.
GOOGLE_CLIENT_ID=
GOOGLE_PICKER_APP_ID=

# --- Storage ---
# Host directory mounted at /data in web/worker/migrate. Relative to compose.yaml.
FILE_STORAGE_HOST_PATH=./file

# --- Execution ---
# Global task concurrency (1-8). Each user's lane is always 1.
TASK_CONCURRENCY=1
CLI_STAGE_TIMEOUT_SECONDS=1800
TASK_TIMEOUT_SECONDS=5400
WORKER_HEARTBEAT_SECONDS=15
WORKER_LEASE_SECONDS=60
MAX_SOURCE_FILE_BYTES=104857600
MAX_RUN_SOURCE_BYTES=524288000
MAX_OCR_PAGES=300

# --- Operator default SMTP sender (optional; password in .secrets/smtp_password) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_FROM=

# --- Web Push (optional; private key in .secrets/vapid_private_key) ---
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# --- ngrok profile (optional; token in .secrets/ngrok_authtoken) ---
NGROK_DOMAIN=
